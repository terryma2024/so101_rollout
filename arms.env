# SO101 串口（by-id 路径，重新插拔后不会变）
FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5CE5122459-if00
LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5CE5113682-if00
FOLLOWER_ID=my_follower
LEADER_ID=my_leader

# 从臂手腕摄像头（实测最高约 22.6 fps，按 20 fps 使用）
WRIST_CAM=/dev/v4l/by-id/usb-icSpring_icspring_camera-video-index0
WRIST_CAM_FPS=20

# 无图形界面（SSH）时 rerun 网页查看器使用的本机地址（Tailscale）
VIEWER_HOST=100.104.202.119
