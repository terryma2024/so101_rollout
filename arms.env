# SO101 串口（by-id 路径，重新插拔后不会变）
FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5CE5122459-if00
LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5CE5113682-if00
FOLLOWER_ID=my_follower
LEADER_ID=my_leader

# 从臂手腕摄像头（实测最高约 22.6 fps，按 20 fps 使用）
WRIST_CAM=/dev/v4l/by-id/usb-icSpring_icspring_camera-video-index0
WRIST_CAM_FPS=20

# 无图形界面（SSH）时，把数据发到这台电脑上的原生 rerun 查看器（MacBook，Tailscale 地址）
RERUN_VIEWER_HOST=100.84.127.95
RERUN_VIEWER_PORT=9876

# 侧面摄像头（带序列号的 by-id 路径；用 MJPG 减少 USB 带宽）
# MJPG 只接受 30 fps 设置（设 20 会连接失败），实际输出约 20 fps
SIDE_CAM=/dev/v4l/by-id/usb-icSpring_icspring_camera_202404160005-video-index0
SIDE_CAM_FPS=30
