# 两路摄像头的手动曝光和白平衡（camera_settings.sh lock 使用）
# 曝光单位 0.1 ms（200 = 20 ms）；20 fps 时不要超过 500。白平衡单位 K（2800–6500）。
# 调法：./camera_settings.sh lock && ./camera_settings.sh snap，看截图亮度和颜色，改这里的值再试。
# 2026-10-27 自动调参（calib-20261027/exposure-tune/tune.json）：曝光取与相机自动曝光亮度最接近的值。
# 12:40 侧面相机装到最终位置后重调（exposure-tune-2）：目标亮度 140、过曝 < 1%。
WRIST_EXPOSURE=40
WRIST_WB=auto      # 待定：腕部相机的手动白平衡对不上自动白平衡，见 README 7.1；auto = 保持自动白平衡
# 12:50 侧面绿方块在曝光 30、饱和度 57（默认）时几乎是灰色（HSV 饱和度 15），提高到曝光 40、饱和度 110 后为 82，
# 纸面不过曝（exposure-tune-2/side-e40-s110.png）。
SIDE_EXPOSURE=40
SIDE_WB=3000
SIDE_SATURATION=110
WRIST_SATURATION=    # 空 = 不改（腕部画面颜色正常）
# 0=关, 1=50 Hz, 2=60 Hz（国内电网 50 Hz，避免灯光闪烁条纹）
POWER_LINE=1
